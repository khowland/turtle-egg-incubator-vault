# =============================================================================
# Dockerfile:  Production React Vault (Vite/Nginx)
# Project:     Incubator Vault v9.6.6 — WINC (Clinical Sovereignty Edition)
# Description: Multi-stage build for high-performance React deployment on GCP Cloud Run.
# =============================================================================

# --- Stage 1: Build ---
FROM node:20-slim AS build
WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm install

# Copy source and build
COPY frontend/ .
# Note: Ensure .env is handled via CI/CD secrets, or copy for local docker tests
# COPY frontend/.env . 
RUN npm run build

# --- Stage 2: Serve ---
FROM nginx:stable-alpine
WORKDIR /usr/share/nginx/html

# Copy build artifacts from Stage 1
COPY --from=build /app/dist .

# Custom Nginx config to handle React Router (SPA)
RUN echo 'server { \
    listen 8080; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
